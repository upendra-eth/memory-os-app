# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. Do not commit secrets.

# --- Supabase ---------------------------------------------------------------
# Get from: Supabase dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
#
# NEXT_PUBLIC_SUPABASE_URL: shown as "Project URL"
#   format: https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY: shown as "anon / public" key (safe to expose to browser)
# SUPABASE_SERVICE_ROLE_KEY: shown as "service_role" key (server-only, NEVER expose to client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# --- Gemini ----------------------------------------------------------------
# Get from: https://aistudio.google.com/apikey
# Free tier: 10 RPM, 250K TPM on gemini-2.5-flash-lite.
# NOTE: This is exposed to the browser because of the NEXT_PUBLIC_ prefix.
# That's intentional in the current code; if you want server-only usage,
# drop the prefix here AND in app/entry-actions.ts:8 + lib/rag.ts + lib/entity-detection.ts.
NEXT_PUBLIC_GEMINI_API_KEY=
